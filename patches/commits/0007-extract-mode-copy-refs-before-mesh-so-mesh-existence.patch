From: jinhyuk <wkdwlsgur0928@gmail.com>
Date: Wed, 26 Aug 2026 06:11:46 +0000
Subject: [PATCH 7/7] extract mode: copy refs before mesh so mesh existence
 marks a complete set

---
 data_toolkit/datasets/ObjaverseXL.py | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/data_toolkit/datasets/ObjaverseXL.py b/data_toolkit/datasets/ObjaverseXL.py
index 2f58686..0409ab4 100644
--- a/data_toolkit/datasets/ObjaverseXL.py
+++ b/data_toolkit/datasets/ObjaverseXL.py
@@ -105,9 +105,11 @@ def _gh_found(local_path=None, file_identifier=None, sha256=None, metadata=None,
         return
     repo_root = lp[:-len(inner)].rstrip('/')
     dest_root = os.path.join(out_root, 'extracted', org, repo)
-    _atomic_copy(os.path.join(repo_root, inner), os.path.join(dest_root, inner))
+    # refs FIRST, matched mesh LAST: the mesh file doubles as the "set complete"
+    # marker, so a kill between copies can never strand a mesh without its refs
     for rel in _bp_refs(repo_root, inner):
         _atomic_copy(os.path.join(repo_root, rel), os.path.join(dest_root, rel))
+    _atomic_copy(os.path.join(repo_root, inner), os.path.join(dest_root, inner))
 
 
 def _append_line(path, line):
